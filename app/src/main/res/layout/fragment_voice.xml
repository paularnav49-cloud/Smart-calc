<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Voice calculator"
        android:textAppearance="@style/TextAppearance.SmartCalc.Title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_horizontal"
        android:text="Say a calculation out loud, like 25 plus 17 into 3."
        android:textAppearance="@style/TextAppearance.SmartCalc.Body"
        android:textColor="@color/md_on_background_muted" />

    <Button
        android:id="@+id/voice_mic"
        style="@style/Widget.SmartCalc.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:text="Speak a calculation" />

    <TextView
        android:id="@+id/voice_heard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.SmartCalc.Body" />

    <TextView
        android:id="@+id/voice_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.SmartCalc.Result"
        android:textColor="@color/md_accent" />
</LinearLayout>
