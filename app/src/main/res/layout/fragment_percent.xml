<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Percentages"
            android:textAppearance="@style/TextAppearance.SmartCalc.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Solve the three common percentage questions."
            android:textAppearance="@style/TextAppearance.SmartCalc.Body"
            android:textColor="@color/md_on_background_muted" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/percent_mode"
            style="@style/Widget.Material3.TextInputLayout.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Question type">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/percent_mode_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="First number (X)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/percent_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal|numberSigned" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Second number (Y)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/percent_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal|numberSigned" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/percent_go"
            style="@style/Widget.SmartCalc.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Calculate" />

        <TextView
            android:id="@+id/percent_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="start"
            android:textAppearance="@style/TextAppearance.SmartCalc.Result"
            android:textColor="@color/md_accent" />
    </LinearLayout>
</ScrollView>
