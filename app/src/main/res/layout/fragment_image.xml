<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Image generator"
            android:textAppearance="@style/TextAppearance.SmartCalc.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Describe anything. Images are generated with Flux via Pollinations."
            android:textAppearance="@style/TextAppearance.SmartCalc.Body"
            android:textColor="@color/md_on_background_muted" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Describe the image">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/image_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/image_go"
            style="@style/Widget.SmartCalc.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Generate" />

        <ProgressBar
            android:id="@+id/image_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/image_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.SmartCalc.Body"
            android:textColor="@color/md_error"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/image_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_image"
            android:contentDescription="Generated image"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/image_save_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Tap the image to save it"
            android:textAppearance="@style/TextAppearance.SmartCalc.Body"
            android:textColor="@color/md_on_background_muted"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
